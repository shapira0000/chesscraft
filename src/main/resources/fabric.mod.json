{
	"schemaVersion": 1,
	"id": "chesscraft",
	"version": "${version}",
	"name": "ChessCraft",
	"description": "A complete chess system: a table base, a 3x3 live chess board, twelve placeable chess pieces, full FIDE rules and a built-in chess engine from 100 to 3200 Elo.",
	"authors": ["yossi"],
	"license": ["CC0-1.0", "Apache-2.0 (Open Sans font only)"],
	"icon": "assets/chesscraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["com.yossi.chesscraft.fabric.ChessCraftFabric"],
		"client": ["com.yossi.chesscraft.fabric.ChessCraftFabricClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
